# ============================================================
# JARVIS Desk Assistant — environment configuration
# Copy this file to `.env` and fill in your keys.
# Everything has a safe default: with NO keys at all, the
# assistant still runs in offline fallback mode.
# ============================================================

# --- LLM brain -------------------------------------------------
# Provider: "anthropic" (default) or "none" (offline fallback mode)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Cheap model for everyday chat / simple tasks
LLM_MODEL_FAST=claude-haiku-4-5
# Strong model for hard reasoning, long documents, vision
LLM_MODEL_SMART=claude-sonnet-5
# Max tokens per reply (cost control)
LLM_MAX_TOKENS=1024

# --- Vision ----------------------------------------------------
# Provider for image analysis: "anthropic" (uses the smart model) or "none"
VISION_PROVIDER=anthropic
# Camera device index (0 = first webcam; try 1, 2 if wrong camera opens)
CAMERA_INDEX=0
# Longest image edge sent to the API (smaller = cheaper). 1024 is a good balance.
VISION_MAX_IMAGE_EDGE=1024
# How many days to keep snapshots on disk (privacy + disk space). 0 = delete immediately after analysis.
SNAPSHOT_RETENTION_DAYS=7

# --- Speech-to-text --------------------------------------------
# Provider: "local_whisper" (free, offline) or "none" (typed input only)
STT_PROVIDER=local_whisper
# faster-whisper model size: tiny / base / small / medium
WHISPER_MODEL_SIZE=base
# Microphone device index (leave blank for system default; run `python -m app.audio.push_to_talk --list` to list)
MIC_DEVICE_INDEX=
# Recording sample rate
MIC_SAMPLE_RATE=16000

# --- Text-to-speech --------------------------------------------
# Provider: "pyttsx3" (free, offline), or "none" (text-only replies)
TTS_PROVIDER=pyttsx3
# Speaking rate in words-per-minute (pyttsx3)
TTS_RATE=180

# --- Storage / memory ------------------------------------------
DATABASE_PATH=data/jarvis.db
# Max conversation turns kept as context for the LLM (cost control)
MEMORY_CONTEXT_TURNS=12

# --- Dashboard --------------------------------------------------
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8321

# --- Misc -------------------------------------------------------
# true = verbose logging to console
DEBUG=false
# Directory the project-folder scanner is allowed to read (safety boundary)
PROJECTS_DIR=
