# ============================================================
# JARVIS Desk Assistant — environment configuration
# Copy this file to `.env` and fill in your keys.
# Everything has a safe default: with NO keys at all, the
# assistant still runs in offline fallback mode.
# ============================================================

# --- LLM brain -------------------------------------------------
# Brain source:
#   anthropic   = Claude API key (fastest replies; pay-as-you-go)  <- default
#   claude_code = your Claude Pro/Max subscription via the Claude Code CLI
#                 (no API cost, ~4-8s per reply; setup: install Node.js, then
#                  npm install -g @anthropic-ai/claude-code, then run `claude`
#                  once and log in with your claude.ai account)
#   hybrid      = chat on the API, big tasks (documents/vision) on your
#                 subscription — snappy replies AND a lower bill
#   local_first = everyday chat on a FREE local model (Ollama), cloud only
#                 for hard questions, vision, documents and agent tasks —
#                 cheapest AND most private (setup: install https://ollama.com
#                 then `ollama pull qwen3:8b`)
#   ollama      = local model only; $0, fully offline, no agent/vision
#   none        = offline fallback mode
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Cheap model for everyday chat / simple tasks
LLM_MODEL_FAST=claude-haiku-4-5
# Strong model for hard reasoning, long documents, vision
LLM_MODEL_SMART=claude-sonnet-5
# Premium model for heavy work — used ONLY when you ask for it ("in-depth
# report", "deep dive", "comprehensive", "use opus"). Never runs on ordinary
# chat, so it costs nothing until summoned.
LLM_MODEL_DEEP=claude-opus-4-8
# Max tokens per reply (cost control)
LLM_MAX_TOKENS=1024
# Local model settings (for local_first / ollama providers)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_S=120
# Embedding model for RAG (/ask and /index — searching your own notes & vault).
# Runs locally on Ollama; free & private. Install once: ollama pull nomic-embed-text
EMBED_MODEL=nomic-embed-text
# Where /export writes your notes/memories/tasks as Markdown (Obsidian-ready).
# Point at a folder inside your Obsidian vault to browse JARVIS memory there.
OBSIDIAN_VAULT=data/vault
# Let JARVIS search the web for current info (news, scores, prices).
# ~$0.01 per search on the API backend; uses Claude Code's search on that backend.
WEB_SEARCH_ENABLED=true
# Max searches per single question/task.
WEB_SEARCH_MAX_USES=5

# --- Vision ----------------------------------------------------
# Provider for image analysis: "anthropic" (uses the smart model) or "none"
VISION_PROVIDER=anthropic
# Camera device index (0 = first webcam; try 1, 2 if wrong camera opens)
CAMERA_INDEX=0
# Longest image edge sent to the API (smaller = cheaper). 1024 is a good balance.
VISION_MAX_IMAGE_EDGE=1024
# How many days to keep snapshots on disk (privacy + disk space). 0 = delete immediately after analysis.
SNAPSHOT_RETENTION_DAYS=7

# --- Speech-to-text --------------------------------------------
# Provider: "local_whisper" (free, offline) or "none" (typed input only)
STT_PROVIDER=local_whisper
# faster-whisper model size: tiny / base / small / medium
WHISPER_MODEL_SIZE=base
# Microphone device index (leave blank for system default; run `python -m app.audio.push_to_talk --list` to list)
MIC_DEVICE_INDEX=
# Recording sample rate
MIC_SAMPLE_RATE=16000

# --- Hands-free wake word --------------------------------------
# true = say "jarvis" to talk, no typing needed. Privacy note: this keeps the
# mic streaming so it can hear the wake word — audio is scored locally and
# discarded, never stored or uploaded. Say "shutdown" (or /sleep) to close
# the mic completely; typing anything (or /listen) turns it back on.
# Needs: pip install openwakeword onnxruntime
WAKE_WORD_ENABLED=true
# openWakeWord model. "hey_jarvis" also fires on a clear "jarvis".
WAKE_WORD_MODEL=hey_jarvis
# 0.0-1.0. Lower = triggers more easily (more false alarms); raise to ~0.6 if
# it fires on TV/music, lower to ~0.4 if it misses you.
WAKE_WORD_THRESHOLD=0.5
# After JARVIS answers, keep listening ~8s so you can reply without the wake word.
FOLLOW_UP_LISTEN=true
# Interrupt JARVIS by talking over it (sustained, clear speech cuts it off).
BARGE_IN=true

# --- Text-to-speech --------------------------------------------
# Provider:
#   pyttsx3 = free offline OS voice (robotic but zero setup)  <- default
#   piper   = natural offline NEURAL voice — the movie-JARVIS upgrade. Needs the
#             `piper` binary on PATH (https://github.com/rhasspy/piper) and a
#             downloaded voice model set in PIPER_VOICE_MODEL below. If either is
#             missing, JARVIS quietly falls back to the OS voice (never goes mute).
#   none    = text-only replies
TTS_PROVIDER=pyttsx3
# Piper voice model: full path to a .onnx voice (download the .onnx AND its
# matching .onnx.json into the same folder). Example after downloading:
#   PIPER_VOICE_MODEL=/Users/you/piper/en_US-lessac-medium.onnx
PIPER_VOICE_MODEL=
# piper binary name/path (default: found on PATH) and multi-speaker id (optional)
PIPER_BINARY=piper
PIPER_SPEAKER=
# Speaking rate in words-per-minute (pyttsx3)
TTS_RATE=180
# System voice id (easiest: pick by name in Settings -> Speaker & Voice output)
TTS_VOICE=
# Speaker output device index (blank = system default). Easiest way to set
# this: open the app's Settings page — it lists devices by name.
SPEAKER_DEVICE_INDEX=

# --- Storage / memory ------------------------------------------
DATABASE_PATH=data/jarvis.db
# Max conversation turns kept as context for the LLM (cost control)
MEMORY_CONTEXT_TURNS=12

# --- Dashboard --------------------------------------------------
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8321

# --- Agent mode (computer use + connected apps) -----------------
# true = /agent can use this computer (files, commands, apps) and any
# connected MCP apps to complete multi-step tasks.
AGENT_ENABLED=true
# Folders the agent may read/write, comma-separated. "~" = your home folder.
# Tighten this if you want, e.g. ~/Downloads,~/uni
AGENT_ALLOWED_DIRS=~
# false = every risky action (write file, run command, send email...) asks
# you first. true = act without asking (terminal prompts are safer; only
# enable this if you trust the tasks you give it).
AGENT_AUTO_APPROVE=false
# Max tool steps per /agent task.
AGENT_MAX_STEPS=15
# Connected apps config (Gmail, calendar, ... — MCP servers). See
# mcp_servers.example.json and docs/COMPUTER_AND_APPS.md.
MCP_CONFIG_PATH=mcp_servers.json

# --- Optional: Hugging Face token --------------------------------
# Only silences the "unauthenticated requests to the HF Hub" warning and
# speeds up the one-time speech-model download. Free token: huggingface.co
# -> Settings -> Access Tokens -> New token (Read). Fine to leave empty.
HF_TOKEN=

# --- Misc -------------------------------------------------------
# true = verbose logging to console
DEBUG=false
# Directory the project-folder scanner is allowed to read (safety boundary)
PROJECTS_DIR=
